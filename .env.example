# =============================================================================
# TITIK. — Environment Configuration & API Keys
# =============================================================================
# Copy this file to '.env' and fill in your actual API keys.
# Do NOT commit your '.env' file containing real secret keys to version control.
# =============================================================================

# 1. CARTO BASEMAPS (Primary Map Provider)
# CARTO requires a free API key to serve clean, watermark-free basemaps (carto.com/basemaps/apikey).
# If provided, TITIK automatically appends ?key=<API_KEY> to the tile requests.
# If omitted or invalid, TITIK gracefully falls back to OpenStreetMap standard tiles.
VITE_CARTO_API_KEY=
VITE_CARTO_STYLE=voyager

# 2. MAPTILER API KEY (Optional fallback provider)
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=

# 3. GOOGLE GEMINI AI API KEY (Optional: for automated citizen report photo analysis)
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 4. SUPABASE BACKEND (Optional: for live database sync & crowd-report storage)
# https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 5. SIKD & SATU DATA INDONESIA API (Optional: live regional fiscal data sync)
VITE_SIKD_API_URL=https://api.satudata.go.id/v1
VITE_SIKD_API_KEY=
